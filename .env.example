# ====================================================================
# Birthday Verse - Environment Configuration
# ====================================================================

# 1. PERMANENT DATABASE (Neon PostgreSQL / Cloud SQL / Supabase)
# Paste your Neon connection string here. It automatically provisions the 
# 'profiles' table and seeds all your loved ones' birthday records.
DATABASE_URL="postgresql://username:password@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. PERMANENT CLOUD OBJECT STORAGE (Cloudinary)
# Create a free account at https://cloudinary.com for permanent image storage.
# Option A: Full Cloudinary URL (easiest)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Option B: Individual Cloudinary credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 3. OWNER AUTHENTICATION & SECURITY
# The secret PIN or password used by the website owner to unlock the Admin Panel,
# upload pictures, and add/edit/delete birthday profiles.
OWNER_PIN="Shubhade#7002"
JWT_SECRET="birthday-verse-owner-secret-key-2026"

# 4. SERVER & HOSTING
PORT=3000
NODE_ENV="development"
